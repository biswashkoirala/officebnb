# Copy to .env for local development. In production set the same variables in
# Vercel → Project → Settings → Environment Variables. All VITE_ values end up
# in the browser, so only ever put *publishable* keys here — never a secret key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# pk_test_... while testing, pk_live_... in production
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Shown on the Terms / Privacy / Contact pages and in the footer
VITE_BUSINESS_LEGAL_NAME=Your Name trading as Officebnb
VITE_BUSINESS_ABN=00 000 000 000
VITE_SUPPORT_EMAIL=support@yourdomain.com.au
